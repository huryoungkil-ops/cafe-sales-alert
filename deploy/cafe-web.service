[Unit]
Description=카페 매출 알리미 웹 (127.0.0.1:5740, 바깥 HTTPS 는 Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cafesales
WorkingDirectory=/opt/cafe-sales-alert
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --dns-result-order=ipv4first --no-network-family-autoselection src/web.js
Restart=always
RestartSec=5
Environment=TZ=Asia/Seoul PORT=5740 HOST=127.0.0.1
# DB 는 cafesales 계정만 읽게
UMask=0077
MemoryMax=160M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/cafe-sales-alert/data

[Install]
WantedBy=multi-user.target
